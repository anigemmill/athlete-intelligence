# ── Database ───────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/athlete_intelligence

# ── Clerk Authentication ────────────────────────────────────────────────────────
# Get from your Clerk dashboard at https://dashboard.clerk.com
# On Replit, these are managed secrets — do not hardcode here
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# VITE_ prefix is required for browser-accessible env vars
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# Random 64-character string for session signing
SESSION_SECRET=change_me_to_a_random_64_character_string

# ── AI APIs ────────────────────────────────────────────────────────────────────
# OpenAI — used for GPT-4o extraction and AI analyst chat
# On Replit, these are managed via AI Integrations (not regular secrets)
AI_INTEGRATIONS_OPENAI_API_KEY=sk-...
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# OpenRouter — used for Perplexity Sonar live web search
AI_INTEGRATIONS_OPENROUTER_API_KEY=sk-or-...
AI_INTEGRATIONS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Stripe ─────────────────────────────────────────────────────────────────────
# Use test keys for development, live keys for production
STRIPE_SECRET_KEY=sk_test_...

# ── Application ────────────────────────────────────────────────────────────────
# Port the API server listens on (set automatically by Replit)
PORT=3000

# Email address that is granted admin access to /api/admin/* routes
FOUNDER_EMAIL=your@email.com

# ── Optional ───────────────────────────────────────────────────────────────────
# Twitter/X API v2 Bearer Token for live follower count lookups
# Without this, follower counts come from Perplexity (less accurate)
# TWITTER_BEARER_TOKEN=AAAA...
